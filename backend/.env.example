# CareerCoach AI - Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# Session secret - change this to a long, random string in production
SESSION_SECRET=change_this_to_a_very_long_random_secret_string_min_32_chars

# CORS - comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database path (relative to backend/)
DB_PATH=./data/careercoach.db

# AI API Keys (Optional - for live LLM evaluations in Phase 4)
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Alternative: OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
