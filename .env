
VITE_API_URL=http://localhost:5002/api      # URL the front‑end will call
ALLOWED_ORIGINS=http://localhost:5002       # In production change to your domain, e.g. https://careercoach.example.com
PORT=5002                                   # Port the Express server will listen on
SESSION_SECRET=super_secret_please_change   # Strong secret for signed cookies
DB_PATH=./data/careercoach.db                # Path to the SQLite DB (will be created automatically)
COOKIE_SECURE=true                          # Set to true when serving over HTTPS
# OPTIONAL – AI feedback
# OPENAI_API_KEY=sk-...                     # Only required if you enable the AI feature
