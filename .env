
# ── Local development overrides ──────────────────────────────────────────────
# VITE_API_URL is intentionally left empty so the production build uses a
# relative /api path and works on any host (local LAN, Render, Railway, etc.)
# Uncomment and set only when running Vite dev server (port 5173) separately
# from the Express server (port 5002).
# VITE_API_URL=http://localhost:5002/api

PORT=5002
SESSION_SECRET=super_secret_please_change_in_production
DB_PATH=./data/careercoach.db

# Set to false for local HTTP access; change to true only when behind HTTPS
COOKIE_SECURE=false

ALLOWED_ORIGINS=*

# OPTIONAL – AI feedback (only needed if the OpenAI feature is enabled)
# OPENAI_API_KEY=sk-...
